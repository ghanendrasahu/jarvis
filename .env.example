# JARVIS example configuration.
# Copy to .env and adjust. Every key mirrors a field in app/config.py
# (pydantic-settings matches names case-insensitively); keep this file in
# sync with that model.

# ----------------------------------------------------------------- general / runtime

APP_NAME=JARVIS
ENVIRONMENT=development
WORKSPACE_ROOT=.
DATA_DIR=data
LOGS_DIR=logs
DATABASE_PATH=data/jarvis.db
# HUD watchdog: re-enable the EXECUTE button if a command produces no result within N seconds.
COMMAND_BUSY_TIMEOUT_SECONDS=180
# Spoken + on-screen welcome greeting when the HUD starts.
STARTUP_GREETING_ENABLED=true

# ----------------------------------------------------------------- planner LLM providers

# LLM provider for the command planner: openai, groq, ollama, cerebras, openrouter, or litellm.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Cerebras (free, 60K TPM - 7.5x more than Groq's free tier).
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gpt-oss-120b

# OpenRouter (free, 20+ models, single API key).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Planner fallback chain: tried in order when the primary provider fails (413/429/500).
# Provider names: openai, groq, ollama, cerebras, openrouter, litellm. Comma separated.
LLM_FALLBACK_PROVIDERS=
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=1.0
LLM_TIMEOUT_SECONDS=30
# Hard wall-clock budget for a full planner fallback chain (all providers + retries).
LLM_FALLBACK_DEADLINE_SECONDS=180

# LiteLLM gateway (optional extra: pip install -e .[litellm]).
# Model names are provider-prefixed, e.g. groq/llama-3.3-70b-versatile or openai/gpt-4o.
LITELLM_MODEL=groq/llama-3.3-70b-versatile
LITELLM_API_BASE=
LITELLM_API_KEY=

# Fast-planner result cache: repeat commands skip the LLM call entirely (plan cached in SQLite).
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_DAYS=7
LLM_CACHE_MAX_ENTRIES=500

# ----------------------------------------------------------------- AI assistant chat

# Dedicated conversational model layer (streaming), independent from the command planner:
# normal questions go here; commands ("open chrome") keep using the planner pipeline.
# Get a key at https://opencode.ai/auth
# Known providers: opencode|zen, groq, cerebras, openrouter, ollama.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Primary chat provider/model. Empty model = provider default (opencode: nemotron-3-ultra-free).
JARVIS_CHAT_PROVIDER=opencode
JARVIS_CHAT_MODEL=

# Fallback chain, tried in order on timeout / 429 / connection errors ("provider:model").
JARVIS_CHAT_FALLBACK_1=zen:nemotron-3.5-lightning-free
JARVIS_CHAT_FALLBACK_2=groq:llama-3.1-8b-instant
JARVIS_CHAT_FALLBACK_3=cerebras:gpt-oss-120b
# Additional entries appended after FALLBACK_1..3, comma separated:
# JARVIS_CHAT_FALLBACK_PROVIDERS=

# Chat client behaviour (controls the live chat client, unlike the planner's fixed timeouts).
JARVIS_CHAT_TIMEOUT_SECONDS=30
JARVIS_CHAT_MAX_RETRIES=1
# Hard wall-clock budget for the whole chain (all providers + retries).
JARVIS_CHAT_DEADLINE_SECONDS=90
JARVIS_CHAT_HISTORY_WINDOW=12
# Empty = API defaults apply; set plain integers/floats to override.
JARVIS_CHAT_MAX_TOKENS=
JARVIS_CHAT_TEMPERATURE=
# Send attached images to the model (requires a vision-capable chat model).
# When false, images still render in the GUI but are stripped from requests.
JARVIS_CHAT_VISION_ENABLED=false

# ----------------------------------------------------------------- agent reasoning tier

# Route routine planning to a fast/cheap model and the autonomous-agent loop to a bigger one.
# Leave AGENT_LLM_PROVIDER empty to reuse the main LLM provider/model.
AGENT_LLM_PROVIDER=
AGENT_OPENAI_MODEL=
AGENT_GROQ_MODEL=
AGENT_OLLAMA_MODEL=
AGENT_CEREBRAS_MODEL=
AGENT_OPENROUTER_MODEL=
AGENT_LITELLM_MODEL=

# ----------------------------------------------------------------- voice / STT / understanding

WAKE_WORD=jarvis
VOICE_ENABLED=true
TTS_ENABLED=true
SPEECH_TIMEOUT_SECONDS=8
PHRASE_TIME_LIMIT_SECONDS=12
MAX_VOICE_RESPONSE_CHARS=260
VOICE_FOLLOWUP_WINDOW_SECONDS=10
VOICE_FOLLOWUP_STICKY_MODE=true
# Sticky follow-up auto-expires after N seconds; wake word required again.
VOICE_FOLLOWUP_MAX_SECONDS=120
VOICE_CONFIRM_BEFORE_SEND=true
VOICE_MIN_TRANSCRIPT_CHARS=2
SPEECH_AMBIENT_ADJUST_DURATION_SECONDS=0.25
SPEECH_AMBIENT_ADJUST_INTERVAL_SECONDS=25

# Voice understanding pipeline: Whisper (hearing) -> fuzzy cleanup -> semantic LLM (understanding)
# -> router (deciding). The semantic pass only runs for suspicious transcripts; obvious commands
# go straight to the router. It can never execute anything by itself.
STT_LANGUAGE=en
STT_PROMPT_BIAS=true
VOICE_FUZZY_CUTOFF=88
# Conservative Whisper garbage filter (ambiguous-but-real speech still flows to the semantic layer).
VOICE_MIN_AVG_LOGPROB=-1.0
VOICE_MAX_NO_SPEECH_PROB=0.9
# Fuzzy wake word: accepts spoken variants like "Jervis"/"Jarvic"; keep >=80 to avoid false wakes.
WAKE_WORD_FUZZY_ENABLED=true
WAKE_WORD_FUZZY_SCORE=82
# Semantic normalizer reuses your free LLM providers (empty = auto: groq, cerebras, openai,
# openrouter; or "ollama"). Empty model = provider default (groq/cerebras: llama-3.1-8b-instant).
VOICE_SEMANTIC_ENABLED=true
VOICE_SEMANTIC_PROVIDER=
VOICE_SEMANTIC_MODEL=
VOICE_SEMANTIC_TIMEOUT_SECONDS=5
# Minimum RapidFuzz similarity for an LLM-proposed app/site target (blocks invented targets).
VOICE_FUZZY_TARGET_SCORE=75

# STT backend chain. Primary "qwen3" runs the local Qwen3-ASR model (lazy-loaded on first use
# from the shared HF cache); on failure it falls back to "groq" (Whisper large-v3-turbo API).
# Set VOICE_STT_BACKEND=groq to switch back to cloud-only Whisper with one config change.
VOICE_STT_BACKEND=qwen3
VOICE_STT_FALLBACK=groq
QWEN_STT_MODEL_ID=Qwen/Qwen3-ASR-0.6B-hf

# Voice-loop watchdog: auto-restart a crashed loop thread; warn when silent longer than N seconds.
VOICE_WATCHDOG_ENABLED=true
VOICE_WATCHDOG_STALE_SECONDS=90
VOICE_WATCHDOG_MAX_RESTARTS=5

# ----------------------------------------------------------------- TTS

# TTS engine: sapi | pyttsx3 | kokoro.
# Kokoro-82M requires: pip install -e .[tts] + espeak-ng system package.
TTS_ENGINE=kokoro
KOKORO_VOICE=af_bella
# Kokoro language code: a=American English, b=British, j=Japanese, z=Chinese, etc.
KOKORO_LANG_CODE=a
KOKORO_SPEED=1.0

# ----------------------------------------------------------------- RAG / memory

# RAG / knowledge memory (both disabled by default: lexical retrieval only when enabled).
RAG_ENABLED=false
RAG_INDEX_PATH=data/rag.db
RAG_NOTES_DIR=data/notes
# true = semantic embeddings via Ollama (ollama pull nomic-embed-text); false = offline lexical retrieval.
RAG_EMBEDDINGS_ENABLED=false
RAG_EMBED_MODEL=nomic-embed-text
RAG_TOP_K=5
RAG_CHUNK_CHARS=512
RAG_CHUNK_OVERLAP_CHARS=64

# Local calendar (SQLite events).
CALENDAR_PATH=data/calendar.db

# ----------------------------------------------------------------- browser automation

# Set false to skip Playwright tools when unavailable.
BROWSER_ENABLED=true
BROWSER_PROFILE_DIR=data/browser_profile
BROWSER_AUTOMATION_TIMEOUT_MS=15000

# ----------------------------------------------------------------- safety / approvals

APPROVAL_POLICY=medium_and_high
AUTO_APPROVE_LOW_RISK=true
MAX_HISTORY_ITEMS=20
TOOL_RETRY_ATTEMPTS=1
TOOL_RETRY_BACKOFF_SECONDS=0.4
# Max concurrent tool workers that timed out but keep running in the background;
# new executions fail fast while the cap is reached.
EXECUTOR_MAX_ORPHANED_WORKERS=16
# Retention: prune history/metrics older than N days on startup.
DB_RETENTION_DAYS=60

# Shell allowlist for the shell tool (comma separated). Interpreters and script
# hosts (python, pip, powershell, cmd, ...) are always refused, even if listed.
ALLOWED_SHELL_COMMANDS=get-date,get-process,get-service,get-childitem,tasklist,ipconfig,ping,where,dir,git
# Extra file-access roots beyond WORKSPACE_ROOT (comma separated). The home directory is
# intentionally NOT implicit; add explicit roots here when broader access is required.
ALLOWED_ROOTS=

# ----------------------------------------------------------------- autonomous agent

AGENT_MAX_ITERATIONS=6
AGENT_ACTION_CAP=25
# none = full autonomy, high_only / medium_and_high / all = human checkpoints during agent runs.
AGENT_APPROVAL_POLICY=none

# Coding agent: edit -> verify (run_tests + lint_code) -> fix loop.
CODE_MAX_FIX_ROUNDS=3
CODE_VERIFY_AFTER_EDIT=true

# ----------------------------------------------------------------- vision

# Screen/image understanding: auto | openai | groq | ollama | litellm | disabled.
# auto mirrors the main LLM provider (falls back to local Ollama/llava). Empty model = default.
VISION_PROVIDER=auto
VISION_MODEL=

# ----------------------------------------------------------------- job automation

JOB_PROFILE_PATH=config/job_profile.yaml
JOB_SITE_PROFILES_PATH=config/site_profiles.yaml
RESUME_PDF_PATH=data/resume/CV.pdf
JOB_TARGET_SITES=linkedin,indeed
JOB_MAX_APPLY_PER_RUN=5
JOB_APPLY_REMOTE_ONLY=false
# Using a dedicated (non-primary) account for Easy Apply automation reduces ban risk.
JOB_USE_BURNER_ACCOUNT=true

# ----------------------------------------------------------------- email (optional)

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

APP_NAME=JARVIS
ENVIRONMENT=development
WORKSPACE_ROOT=.
DATA_DIR=data
LOGS_DIR=logs
DATABASE_PATH=data/jarvis.db

# LLM provider: openai, groq, ollama, or litellm (optional extra: pip install -e .[litellm])
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Fast-planner result cache: repeat commands skip the LLM call entirely (plan cached in SQLite).
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_DAYS=7
LLM_CACHE_MAX_ENTRIES=500

# RAG / knowledge memory
RAG_ENABLED=true
RAG_INDEX_PATH=data/rag.db
RAG_NOTES_DIR=data/notes
# true = semantic embeddings via Ollama (ollama pull nomic-embed-text); false = offline lexical retrieval
RAG_EMBEDDINGS_ENABLED=true
RAG_EMBED_MODEL=nomic-embed-text
RAG_TOP_K=5
RAG_CHUNK_CHARS=512
RAG_CHUNK_OVERLAP_CHARS=64

# Agent reasoning tier: leave AGENT_LLM_PROVIDER empty to reuse the main provider/model.
# Route routine planning to a fast/cheap model and the autonomous-agent loop to a bigger one.
AGENT_LLM_PROVIDER=
AGENT_OPENAI_MODEL=
AGENT_GROQ_MODEL=
AGENT_OLLAMA_MODEL=

# LiteLLM gateway (optional): set LLM_PROVIDER=litellm and install `pip install -e .[litellm]`.
# Model names are provider-prefixed, e.g. groq/llama-3.3-70b-versatile or openai/gpt-4o.
LITELLM_MODEL=groq/llama-3.3-70b-versatile
LITELLM_API_BASE=
LITELLM_API_KEY=

# Voice
WAKE_WORD=jarvis
VOICE_ENABLED=true
TTS_ENABLED=true
SPEECH_TIMEOUT_SECONDS=8
PHRASE_TIME_LIMIT_SECONDS=12
MAX_VOICE_RESPONSE_CHARS=260
VOICE_FOLLOWUP_WINDOW_SECONDS=10
VOICE_FOLLOWUP_STICKY_MODE=true
VOICE_CONFIRM_BEFORE_SEND=true
VOICE_MIN_TRANSCRIPT_CHARS=2
SPEECH_AMBIENT_ADJUST_DURATION_SECONDS=0.25
SPEECH_AMBIENT_ADJUST_INTERVAL_SECONDS=25

# Safety
APPROVAL_POLICY=medium_and_high
AUTO_APPROVE_LOW_RISK=true
MAX_HISTORY_ITEMS=40
TOOL_RETRY_ATTEMPTS=1
TOOL_RETRY_BACKOFF_SECONDS=0.4
# Retention: prune history/metrics older than N days on startup.
DB_RETENTION_DAYS=60

# Browser automation
BROWSER_PROFILE_DIR=data/browser_profile
BROWSER_AUTOMATION_TIMEOUT_MS=15000

# Autonomous agent
AGENT_MAX_ITERATIONS=6
AGENT_ACTION_CAP=25
# none = full autonomy, high_only / medium_and_high / all = human checkpoints during agent runs
AGENT_APPROVAL_POLICY=none

# Coding agent: edit -> verify (run_tests + lint_code) -> fix loop
CODE_MAX_FIX_ROUNDS=3
CODE_VERIFY_AFTER_EDIT=true

# Vision (screen/image understanding): auto | openai | groq | ollama | litellm | disabled
# auto mirrors the main LLM provider (falls back to local Ollama/llava).
VISION_PROVIDER=auto
VISION_MODEL=

# Job automation
JOB_PROFILE=config/job_profile.yaml
JOB_SITE_PROFILES=config/site_profiles.yaml
RESUME_PDF=data/resume/CV.pdf
JOB_TARGET_SITES=linkedin,indeed
JOB_MAX_APPLY_PER_RUN=5
JOB_APPLY_REMOTE_ONLY=false
# Using a dedicated (non-primary) account for Easy Apply automation reduces ban risk.
JOB_USE_BURNER_ACCOUNT=true

# Optional SMTP email tool
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

ALLOWED_SHELL_COMMANDS=get-date,get-process,get-service,get-childitem,tasklist,ipconfig,ping,where,dir,git,python,pip
ALLOWED_ROOTS=C:\Users\YOURNAME\Documents


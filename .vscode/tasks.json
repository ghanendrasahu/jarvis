{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "JARVIS: auto-start HUD",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/jarvirun.ps1",
        "autostart",
        "run"
      ],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared",
        "close": true
      },
      "problemMatcher": []
    }
  ]
}